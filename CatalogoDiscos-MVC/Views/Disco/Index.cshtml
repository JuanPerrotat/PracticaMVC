@model IEnumerable<dominio.Disco>

@{
    ViewData["Title"] = "Lista de discos";
}

<h1>Discos</h1>
<hr/>
<table class="table container-text-center justify-content-center">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaLanzamiento)
            </th>
            <th>
                Cantidad de canciones
            </th>
            <th>
                Imagen
            </th>
            <th>
                Estilos
            </th>
            <th>
                Formato
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Titulo)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FechaLanzamiento)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CantidadCanciones)
                </td>
                <td>
                    <img src="@item.UrlTapa" height="80" />
                </td>
                <td>
                    @Html.DisplayFor(model => item.Estilo.Descripcion)
                </td>
                <td>
                    @Html.DisplayFor(model => item.TipoEdicion.Descripcion)
                </td>
                <td class="btn-group-sm">
                    <a asp-action="Edit" class="btn btn-outline-success" asp-route-id="@item.Id">Modificar</a> |
                    <a asp-action="Details" class="btn btn-outline-dark" asp-route-id="@item.Id">Ver detalle</a> |
                    <a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.Id">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<p>
    <a class="btn btn-outline-primary" asp-action="Create">Nuevo disco</a>
</p>
