@model dominio.Disco

@{
    ViewData["Title"] = "Detalle";
}

<h1>Detalle de disco</h1>
<h4>Disco</h4>
<hr />

<div class="row">

    <dl class="col">
        <dt class="col-md-4">
            @Html.DisplayNameFor(model => model.Titulo):
        </dt>
        <dd class="col-md-4">
            @Html.DisplayFor(model => model.Titulo)
        </dd>

        <dt class="col-md-4">   
            @Html.DisplayNameFor(model => model.FechaLanzamiento):
        </dt>
        <dd class="col-md-4">
            @Html.DisplayFor(model => model.FechaLanzamiento)
        </dd>

        <dt class="col-md-4">
            @Html.DisplayNameFor(model => model.CantidadCanciones):
        </dt>
        <dd class="col-md-4">
            @Html.DisplayFor(model => model.CantidadCanciones)
        </dd>
        <dt class="col-md-4">
            Género;
        </dt>
        <dd class="col-md-4">
            @Html.DisplayFor(model => model.Estilo.Descripcion)
        </dd>

        <dt class="col-md-4">
            Formato:
        </dt>
        <dd class="col-md-4">
            @Html.DisplayFor(model => model.TipoEdicion.Descripcion)
        </dd>
    </dl>
    <div class="col-md-6">
        <img src="@Model.UrlTapa" id="imgTapa" height="200" />
    </div>
</div>


<div>
    <a asp-action="Edit" class="btn btn-outline-success" asp-route-id="@Model?.Id">Modificar</a> |
    <a asp-action="Index" class="btn btn-outline-primary">Volver</a>
</div>
