@model dominio.Disco

@{
    ViewData["Title"] = "Modificar";
}

<h1>Editar disco</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-2">
                <label asp-for="Titulo" class="control-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="FechaLanzamiento" class="control-label"></label>
                <input asp-for="FechaLanzamiento" type="date" value="@Model.FechaLanzamiento.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="FechaLanzamiento" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="CantidadCanciones" class="control-label"></label>
                <input asp-for="CantidadCanciones" class="form-control" />
                <span asp-validation-for="CantidadCanciones" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="UrlTapa" class="control-label"></label>
                <input asp-for="UrlTapa" id="txtUrlTapa" class="form-control" />
                <span asp-validation-for="UrlTapa" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label class="control-label">Género</label>
                <select asp-for="Estilo.Id" asp-items="ViewBag.Generos" class="form-control"></select>
            </div>
            <div class="form-group mb-2">
                <label class="control-label">Formato</label>
                <select asp-for="TipoEdicion.Id" asp-items="ViewBag.Formatos" class="form-control"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary mt-2" />
            </div>
        </form>
    </div>
    <div class="col-4">
        <img src="https://i0.wp.com/impactify.io/wp-content/uploads/2024/05/placeholder-1.png?fit=1200%2C800&ssl=1&w=640" id="imgTapa" height="200" class="img-fluid" />
    </div>
</div>

<div>
    <a class="btn btn-outline-secondary mt-2" asp-action="Index">Volver</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const txtUrl = document.getElementById("txtUrlTapa");
        const img = document.getElementById("imgTapa");

            const placeholder = "https://i0.wp.com/impactify.io/wp-content/uploads/2024/05/placeholder-1.png?fit=1200%2C800&ssl=1&w=640";

        function cargarImagen() {

            if(txtUrl.value === ""){
                img.src = placeholder;
            }
            else{
                img.src = txtUrl.value;
            }
        }

              img.onerror = function () {
            img.src = placeholder;
        };

        cargarImagen();

        txtUrl.addEventListener("input", function () {
            cargarImagen();
        });

    </script>
}
