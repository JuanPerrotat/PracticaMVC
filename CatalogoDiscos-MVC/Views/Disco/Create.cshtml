@model dominio.Disco

@{
    ViewData["Title"] = "Alta Disco";
}

<h1>Nuevo disco</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <label asp-for="Titulo" class="control-label"></label>
                <input asp-for="Titulo" id="txtUrlTapa" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="FechaLanzamiento" class="control-label"></label>
                <input asp-for="FechaLanzamiento" type="date" class="form-control" />
                <span asp-validation-for="FechaLanzamiento" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="CantidadCanciones" class="control-label"></label>
                <input asp-for="CantidadCanciones" class="form-control" />
                <span asp-validation-for="CantidadCanciones" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="UrlTapa" class="control-label"></label>
                <input asp-for="UrlTapa" class="form-control" />
                <span asp-validation-for="UrlTapa" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Género</label>
                <select class="form-select" asp-for="Estilo.Id" asp-items="ViewBag.Estilo"></select>
                <span asp-validation-for="Estilo" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Formato</label>
                <select class="form-select" asp-for="TipoEdicion.Id" asp-items="ViewBag.TipoEdicion"></select>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
        <div class="col-4">
        <img src="@Model?.UrlTapa" id="imgTapa" height="200" class="img-fluid" />
        </div>
</div>

<div>
    <a class="btn btn-outline-secondary mt-2" asp-action="Index">Volver</a>
</div>

@section Scripts{
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
        <script>
        const txtUrl = document.getElementById("txtUrlTapa");
        const img = document.getElementById("imgTapa");

        txtUrl.addEventListener("input", function () {
            img.src = "txtUrlTapa";
        });
    </script>
    
}