@model dominio.Disco

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar disco</h1>

<h3>¿Estás seguro que quieres eliminar este disco?</h3>
<div class="row">
    <hr />
    <div class="col-md-8">

       
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Titulo):
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Titulo)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.FechaLanzamiento):
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.FechaLanzamiento)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.CantidadCanciones):
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.CantidadCanciones)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Estilo):
            </dt>
            <dd class="col-sm-4">
                @Html.DisplayFor(model => model.Estilo.Descripcion)
            </dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.TipoEdicion):
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TipoEdicion.Descripcion)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Borrar" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </form>

    </div>

    <div class="col-md-4">
        <img src="@Model.UrlTapa" id="imgTapa" height="200" class="img-fluid rounded shadow-sm" />
    </div>

</div>